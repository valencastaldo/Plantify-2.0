// ============================================================
//  Plantify — ESP32 DEVKITC 38 pines
//  Versión con sensor BME680 (reemplaza DHT22 + MQ-135)
//
//  PINOUT actualizado:
//
//  SENSORES (entrada):
//    GPIO21 → BME680 SDA        (bus I2C compartido con OLED)
//    GPIO22 → BME680 SCL        (bus I2C compartido con OLED)
//    GPIO35 → Suelo AOUT        (solo lectura)
//    GPIO34 → LDR               (solo lectura, divisor R4+R5)
//    GPIO33 → libre (antes DHT22)
//    GPIO36 → libre (antes MQ-135)
//
//  ACTUADORES (salida):
//    GPIO14 → Relay K1 IN       (bomba de agua)
//    GPIO13 → Buzzer (+)
//    GPIO18 → LED RGB Rojo  (R) (con R1 220Ω)
//    GPIO17 → LED RGB Verde (G) (con R2 220Ω)
//    GPIO16 → LED RGB Azul  (B) (con R3 220Ω)
//
//  I2C (BME680 + OLED SSD1306 comparten el mismo bus):
//    GPIO21 → SDA
//    GPIO22 → SCL
//
//  ALIMENTACIÓN:
//    +3.3V → OLED VCC, BME680 VCC, Suelo VCC, LDR divisor
//    +5V   → Relay VCC (desde regulador 7805)
//    GND   → Todos los componentes
//
//  LIBRERÍAS NECESARIAS (instalar en Arduino IDE):
//    - Adafruit BME680 Library
//    - Adafruit Unified Sensor
//    - Adafruit SSD1306
//    - Adafruit GFX Library
//    - Blynk (buscar "Blynk" en Library Manager)
//
//  NOTA SOBRE EL BME680:
//    El sensor de gas del BME680 mide una RESISTENCIA (en Ohms):
//    cuanto MÁS alta la resistencia, MEJOR la calidad del aire
//    (menos compuestos volátiles / VOC). Es lo opuesto a como
//    se leía el MQ-135 (donde un ADC alto era aire malo).
//    Los umbrales GAS_BUENO / GAS_MALO son un punto de partida:
//    conviene calibrarlos observando los valores reales del
//    ambiente durante unos días, y dejar ~5 minutos de
//    calentamiento del sensor antes de tomar lecturas serias.
// ============================================================

// ── LIBRERÍAS ────────────────────────────────────────────────
#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BME680.h>
#include <Wire.h>
#include <Adafruit_SSD1306.h>
#include <Adafruit_GFX.h>

// ── CREDENCIALES WiFi y BLYNK ─────────────────────────────────
#define BLYNK_TEMPLATE_ID   "TU_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "Plantify"
#define BLYNK_AUTH_TOKEN    "TU_AUTH_TOKEN"
const char* ssid     = "TU_WIFI_SSID";
const char* password = "TU_WIFI_PASSWORD";

// ── PINES — SENSORES ─────────────────────────────────────────
#define PIN_SUELO     35    // Sensor suelo AOUT (solo lectura)
#define PIN_LDR       34    // LDR divisor tensión (solo lectura)

// ── PINES — ACTUADORES ───────────────────────────────────────
#define PIN_RELAY     14    // Relay K1 → bomba de agua
#define PIN_BUZZER    13    // Buzzer activo
#define PIN_LED_R     18    // LED RGB canal Rojo
#define PIN_LED_G     17    // LED RGB canal Verde
#define PIN_LED_B     16    // LED RGB canal Azul

// ── I2C: BME680 + OLED ───────────────────────────────────────
#define I2C_SDA       21
#define I2C_SCL       22
#define OLED_ADDR     0x3C
#define BME680_ADDR   0x77   // usar 0x76 si el módulo lo requiere
#define ANCHO_OLED    128
#define ALTO_OLED     64

// ── OBJETOS ──────────────────────────────────────────────────
Adafruit_BME680 bme;
Adafruit_SSD1306 pantalla(ANCHO_OLED, ALTO_OLED, &Wire, -1);
BlynkTimer timer;

// ── UMBRALES DE SALUD (basados en recomendaciones OMS) ───────
#define TEMP_MIN        18.0     // °C mínimo saludable
#define TEMP_MAX        26.0     // °C máximo saludable
#define HUM_MIN         40.0     // % humedad mínima
#define HUM_MAX         60.0     // % humedad máxima
#define GAS_BUENO       50000.0  // Ohms: resistencia alta = aire bueno
#define GAS_MALO        10000.0  // Ohms: resistencia baja = aire malo
#define SUELO_SECO      3000     // ADC: suelo seco (necesita riego)
#define SUELO_HUMEDO    1200     // ADC: suelo húmedo (referencia)
#define LUZ_BAJA        3000     // ADC: poca luz ambiental

// ── TIEMPOS ───────────────────────────────────────────────────
#define INTERVALO_LECTURA   2000        // Leer sensores cada 2s
#define INTERVALO_BLYNK     5000        // Enviar a Blynk cada 5s
#define TIEMPO_RIEGO_MS     4000        // Duración de cada riego (4s)
#define ESPERA_RIEGO_MS     300000UL    // Mínimo entre riegos (5 min)

// ── VARIABLES GLOBALES ────────────────────────────────────────
float temperatura     = 0;
float humedad         = 0;
float presion         = 0;      // hPa
float gasResistencia  = 0;      // Ohms
int   valorSuelo      = 0;
int   valorLDR        = 0;
int   estadoSalud     = 0;      // 0=OK · 1=Atención · 2=Alerta
bool  bombaActiva     = false;
int   contAlertas     = 0;
unsigned long tRiego  = 0;

// ── BLYNK VIRTUAL PINS ───────────────────────────────────────
// V0 → Temperatura        V5 → Estado salud (0/1/2)
// V1 → Humedad            V6 → Botón riego manual
// V2 → Calidad aire (Ohms) V7 → Color LED estado
// V3 → Suelo (%)          V8 → Presión (hPa)
// V4 → Luz (%)

// ============================================================
//  SETUP
// ============================================================
void setup() {
  Serial.begin(115200);
  Serial.println("=== Plantify iniciando ===");

  // ── Pines de salida ──
  pinMode(PIN_RELAY,  OUTPUT); digitalWrite(PIN_RELAY,  LOW);
  pinMode(PIN_BUZZER, OUTPUT); digitalWrite(PIN_BUZZER, LOW);
  pinMode(PIN_LED_R,  OUTPUT); digitalWrite(PIN_LED_R,  LOW);
  pinMode(PIN_LED_G,  OUTPUT); digitalWrite(PIN_LED_G,  LOW);
  pinMode(PIN_LED_B,  OUTPUT); digitalWrite(PIN_LED_B,  LOW);

  // ── Bus I2C compartido (BME680 + OLED) ──
  Wire.begin(I2C_SDA, I2C_SCL);

  // ── BME680 ──
  if (!bme.begin(BME680_ADDR)) {
    Serial.println("ERROR: BME680 no encontrado - verificar conexión SDA/SCL/dirección I2C");
  } else {
    bme.setTemperatureOversampling(BME680_OS_8X);
    bme.setHumidityOversampling(BME680_OS_2X);
    bme.setPressureOversampling(BME680_OS_4X);
    bme.setIIRFilterSize(BME680_FILTER_SIZE_3);
    bme.setGasHeater(320, 150);   // 320°C durante 150 ms
    Serial.println("BME680 OK");
  }

  // ── OLED ──
  if (!pantalla.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    Serial.println("ERROR: OLED no encontrada - verificar conexión SDA/SCL");
  } else {
    Serial.println("OLED OK");
    mostrarPantallaBienvenida();
  }

  Serial.println("IMPORTANTE: dejar ~5 min de calentamiento al BME680");
  Serial.println("antes de confiar en la lectura de calidad de aire.");

  // ── WiFi y Blynk ──
  Serial.print("Conectando a WiFi");
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, password);
  Serial.println("\nBlynk conectado!");

  // ── Timers periódicos ──
  timer.setInterval(INTERVALO_LECTURA, leerSensores);
  timer.setInterval(INTERVALO_BLYNK,   enviarBlynk);

  // ── LED verde de inicio (sistema OK) ──
  digitalWrite(PIN_LED_G, HIGH);
  delay(1000);
  digitalWrite(PIN_LED_G, LOW);
}

// ============================================================
//  LOOP PRINCIPAL
// ============================================================
void loop() {
  Blynk.run();
  timer.run();
  controlarRiego();
}

// ============================================================
//  LECTURA DE SENSORES
// ============================================================
void leerSensores() {
  // BME680 — temperatura, humedad, presión y gas (calidad de aire)
  if (bme.performReading()) {
    temperatura    = bme.temperature;
    humedad        = bme.humidity;
    presion        = bme.pressure / 100.0;   // Pa → hPa
    gasResistencia = bme.gas_resistance;      // Ohms
  } else {
    Serial.println("ERROR: fallo de lectura del BME680");
  }

  // Sensores analógicos (GPIO 34/35 son solo entrada, sin pullup interno)
  valorSuelo = analogRead(PIN_SUELO);
  valorLDR   = analogRead(PIN_LDR);

  // Log en monitor serial
  Serial.printf("[SENSORES] T:%.1f°C H:%.1f%% P:%.1fhPa Gas:%.0fOhm Suelo:%d LDR:%d\n",
    temperatura, humedad, presion, gasResistencia, valorSuelo, valorLDR);

  // Evaluar estado y actualizar salidas
  evaluarSalud();
  actualizarOLED();
}

// ============================================================
//  EVALUACIÓN DE SALUD AMBIENTAL
// ============================================================
void evaluarSalud() {
  int prevEstado = estadoSalud;
  estadoSalud = 0;  // Asumir OK

  // ── Verificar temperatura ──
  if (temperatura < TEMP_MIN || temperatura > TEMP_MAX)
    estadoSalud = max(estadoSalud, 1);
  if (temperatura > 30.0 || temperatura < 14.0)
    estadoSalud = 2;

  // ── Verificar humedad ──
  if (humedad < HUM_MIN || humedad > HUM_MAX)
    estadoSalud = max(estadoSalud, 1);
  if (humedad < 25.0 || humedad > 80.0)
    estadoSalud = 2;

  // ── Verificar calidad del aire (BME680: resistencia de gas) ──
  // Resistencia BAJA = más VOC = aire peor
  if (gasResistencia > 0 && gasResistencia < GAS_BUENO)
    estadoSalud = max(estadoSalud, 1);
  if (gasResistencia > 0 && gasResistencia < GAS_MALO)
    estadoSalud = 2;

  // ── Actualizar LED RGB según estado ──
  digitalWrite(PIN_LED_R, LOW);
  digitalWrite(PIN_LED_G, LOW);
  digitalWrite(PIN_LED_B, LOW);

  switch (estadoSalud) {
    case 0:  // Verde — ambiente saludable
      digitalWrite(PIN_LED_G, HIGH);
      break;

    case 1:  // Amarillo (R+G) — atención
      digitalWrite(PIN_LED_R, HIGH);
      digitalWrite(PIN_LED_G, HIGH);
      if (prevEstado < 1) {
        beepSuave();
        contAlertas++;
      }
      break;

    case 2:  // Rojo — alerta de salud
      digitalWrite(PIN_LED_R, HIGH);
      if (prevEstado < 2) {
        beepAlerta();
        contAlertas++;
      }
      break;
  }

  Serial.printf("[SALUD] Estado: %d | Alertas hoy: %d\n",
    estadoSalud, contAlertas);
}

// ============================================================
//  CONTROL RIEGO AUTOMÁTICO
// ============================================================
void controlarRiego() {
  unsigned long ahora = millis();

  // Activar riego si suelo seco y pasó el tiempo mínimo entre riegos
  if (valorSuelo > SUELO_SECO &&
      !bombaActiva &&
      (ahora - tRiego > ESPERA_RIEGO_MS || tRiego == 0)) {

    Serial.println("[RIEGO] Suelo seco detectado — activando bomba");
    digitalWrite(PIN_RELAY, HIGH);
    bombaActiva = true;
    tRiego = ahora;
    Blynk.logEvent("riego_auto", "Riego automático: suelo seco.");
  }

  // Apagar bomba después del tiempo de riego
  if (bombaActiva && (ahora - tRiego > TIEMPO_RIEGO_MS)) {
    Serial.println("[RIEGO] Bomba apagada.");
    digitalWrite(PIN_RELAY, LOW);
    bombaActiva = false;
  }
}

// ============================================================
//  ACTUALIZAR PANTALLA OLED
// ============================================================
void actualizarOLED() {
  pantalla.clearDisplay();
  pantalla.setTextColor(SSD1306_WHITE);
  pantalla.setTextSize(1);

  // Fila 1: Temperatura y humedad
  pantalla.setCursor(0, 0);
  pantalla.printf("T:%.1fC  H:%.0f%%", temperatura, humedad);

  // Fila 2: Calidad del aire
  pantalla.setCursor(0, 12);
  String calAire = (gasResistencia <= 0)        ? "Calentando" :
                    (gasResistencia >= GAS_BUENO) ? "Bueno" :
                    (gasResistencia >= GAS_MALO)  ? "Moderado" : "MALO!!";
  pantalla.printf("Aire: %s", calAire.c_str());

  // Fila 3: Suelo y luz
  pantalla.setCursor(0, 24);
  String estadoSuelo = valorSuelo > SUELO_SECO ? "SECO" : "OK";
  String estadoLuz   = valorLDR   > LUZ_BAJA   ? "Baja" : "OK";
  pantalla.printf("Suelo:%-4s  Luz:%s", estadoSuelo.c_str(), estadoLuz.c_str());

  // Fila 4: Estado de salud (texto grande)
  pantalla.setCursor(0, 38);
  switch (estadoSalud) {
    case 0: pantalla.println(">> AMBIENTE OK"); break;
    case 1: pantalla.println(">> ATENCION!"); break;
    case 2: pantalla.println(">> ALERTA SALUD!"); break;
  }

  // Fila 5: Estado bomba
  if (bombaActiva) {
    pantalla.setCursor(0, 52);
    pantalla.println("Regando planta...");
  }

  pantalla.display();
}

// ============================================================
//  ENVIAR DATOS A BLYNK
// ============================================================
void enviarBlynk() {
  // Convertir ADC suelo a porcentaje
  // SUELO_HUMEDO(1200) = 100%, 3500 = 0%
  int sueloPct = map(constrain(valorSuelo, SUELO_HUMEDO, 3500),
                     3500, SUELO_HUMEDO, 0, 100);

  // Convertir ADC LDR a porcentaje de luz
  int luzPct = map(constrain(valorLDR, 0, 4095), 4095, 0, 0, 100);

  // Enviar valores
  Blynk.virtualWrite(V0, temperatura);
  Blynk.virtualWrite(V1, humedad);
  Blynk.virtualWrite(V2, gasResistencia);
  Blynk.virtualWrite(V3, sueloPct);
  Blynk.virtualWrite(V4, luzPct);
  Blynk.virtualWrite(V5, estadoSalud);
  Blynk.virtualWrite(V8, presion);

  // Color LED Blynk según estado
  switch (estadoSalud) {
    case 0: Blynk.virtualWrite(V7, "#00CC00"); break;  // Verde
    case 1: Blynk.virtualWrite(V7, "#FFA500"); break;  // Naranja
    case 2: Blynk.virtualWrite(V7, "#FF0000"); break;  // Rojo
  }

  // Eventos de alerta push al celular
  if (gasResistencia > 0 && gasResistencia < GAS_MALO)
    Blynk.logEvent("alerta_aire",
      "Calidad del AIRE MALA. Ventila el ambiente ya!");

  if (temperatura > TEMP_MAX + 2)
    Blynk.logEvent("alerta_temp",
      "Temperatura MUY ALTA. Riesgo de golpe de calor.");

  if (humedad < HUM_MIN - 5)
    Blynk.logEvent("alerta_hum",
      "Aire MUY SECO. Riesgo de irritacion respiratoria.");

  if (valorLDR > LUZ_BAJA)
    Blynk.logEvent("alerta_luz",
      "Poca luz natural. Abre las persianas.");
}

// ============================================================
//  RIEGO MANUAL DESDE APP BLYNK (botón virtual V6)
// ============================================================
BLYNK_WRITE(V6) {
  int val = param.asInt();
  if (val == 1 && !bombaActiva) {
    Serial.println("[BLYNK] Riego manual activado desde app");
    digitalWrite(PIN_RELAY, HIGH);
    bombaActiva = true;
    tRiego = millis();
    Blynk.logEvent("riego_manual", "Riego manual activado desde app.");
  }
}

// ============================================================
//  PANTALLA BIENVENIDA (al iniciar)
// ============================================================
void mostrarPantallaBienvenida() {
  pantalla.clearDisplay();
  pantalla.setTextColor(SSD1306_WHITE);
  pantalla.setTextSize(1);
  pantalla.setCursor(8, 10);
  pantalla.println("Plantify");
  pantalla.setCursor(15, 24);
  pantalla.println("Hunter Electronics");
  pantalla.setCursor(8, 40);
  pantalla.println("Conectando WiFi...");
  pantalla.display();
}

// ============================================================
//  BUZZER
// ============================================================
void beepSuave() {
  // 1 beep corto — atención
  digitalWrite(PIN_BUZZER, HIGH);
  delay(150);
  digitalWrite(PIN_BUZZER, LOW);
}

void beepAlerta() {
  // 3 beeps — alerta de salud
  for (int i = 0; i < 3; i++) {
    digitalWrite(PIN_BUZZER, HIGH); delay(200);
    digitalWrite(PIN_BUZZER, LOW);  delay(150);
  }
}

// ============================================================
//  CONFIGURACIÓN BLYNK — datastreams necesarios:
//
//  V0  → Double  "Temperatura"    unidad: °C
//  V1  → Double  "Humedad"        unidad: %
//  V2  → Double  "Calidad aire"   unidad: Ohms (resistencia de gas)
//  V3  → Integer "Suelo"          unidad: %
//  V4  → Integer "Luz"            unidad: %
//  V5  → Integer "Estado salud"   rango: 0-2
//  V6  → Integer "Riego manual"   widget: botón
//  V7  → String  "Color LED"      widget: LED color
//  V8  → Double  "Presión"        unidad: hPa
//
//  EVENTS (crear en Blynk):
//    riego_auto, riego_manual, alerta_aire,
//    alerta_temp, alerta_hum, alerta_luz
// ============================================================
